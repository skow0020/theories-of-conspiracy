{
  "name": "theories-of-conspiracy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "(command -v fuser >/dev/null 2>&1 && fuser -k 3000/tcp || command -v lsof >/dev/null 2>&1 && lsof -ti :3000 | xargs -r kill -9 || true) && node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "serve:ngrok": "./start-public.sh"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
